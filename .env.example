# Copy this file to .env. Never commit a real .env file.
# Choose the same unique local-development password when creating bliss_app.
BLISS_DB_HOST=localhost
BLISS_DB_PORT=3306
BLISS_DB_NAME=bliss_park
BLISS_DB_USER=bliss_app
BLISS_DB_PASS=replace_with_a_unique_local_password
# Set to 1 only after the site is served over HTTPS. On http://localhost leave it 0.
BLISS_SECURE_COOKIES=0
